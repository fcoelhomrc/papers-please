# Architecture of Papers, Please.
#
# Render both themes (the README picks one by prefers-color-scheme):
#   d2 --layout elk --theme 0   --pad 20 assets/architecture.d2 assets/architecture.svg
#   d2 --layout elk --theme 200 --pad 20 assets/architecture.d2 assets/architecture-dark.svg
#
# The edge labels also act as spacing hints: dropping the ones in the gutter
# between the lanes and the datastores makes elk restack the two lanes and
# doubles the width of the render.

direction: right

ingest: "Ingest workers" {
  style.stroke-dash: 3
  scholar: "Semantic\nScholar" { shape: cloud }
  download: download
  chunk: "chunk\nDocling + OCR"
  embed: "embed\n4 encoders"
  scholar -> download: open-access PDF
  download -> chunk -> embed
}

serve: "Query path" {
  style.stroke-dash: 3
  ui: "Frontend\nReact + Vite"
  api: FastAPI
  agent: "Chat agent\nLangGraph"
  retrieval: "Retrieval\ndense + lexical + RRF"
  ui -> api
  api -> agent -> retrieval
  api -> retrieval
}

stores: "" {
  style.fill: transparent
  style.stroke-width: 0
  pg: "Postgres\nrows, chunks, status,\nfull-text index" { shape: cylinder }
  pinecone: "Pinecone\nchunk vectors" { shape: cylinder }
  phoenix: "Phoenix\ntraces" { shape: cylinder }
}

ingest -> stores.pg
ingest.embed -> stores.pinecone: upsert
serve -> stores.pg
serve.retrieval -> stores.pinecone: vector query
serve -> stores.phoenix: spans
